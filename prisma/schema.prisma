datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
}

enum Status {
  DRAFT
  PUBLISHED
}

enum SubmissionType {
  QUERY
  CATALOG
  NEWSLETTER
  DATASHEET
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  color            String   @default("White")
  finish           String?  // legacy single-value field, superseded by finishCategories below
  finishCategories String[] @default([]) // one or more of Polished/Matte/Honed/etc. — a product can be filtered under multiple finishes on the public site
  thicknessMm      String[]
  dimensions       String[]
  format           String?
  applications     String[]
  coverImage       String?
  gallery          String[] @default([])
  
  // Custom configuration for Exhibition/Featured product detail modal
  leftBg           String?
  faces            String[] @default([])
  finishes         String[] @default([])
  slides           Json     @default("[]")
  availableFaces   String[] @default([])
  bookmatchImg     String?
  isHorizontalFace Boolean  @default(false)
  isDark           Boolean  @default(false)

  order            Int      @default(0)
  status           Status   @default(DRAFT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Blog {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleColor     String   @default("black") // "black" | "teal" (#007190) — rendered color of the blog title
  titleFont      String   @default("ivymode") // "ivymode" | "michroma" — rendered font of the blog title
  titleFontSize  String   @default("standard") // "small" | "standard" | "large" | "xlarge" — rendered size of the blog title
  showDateOnCard   Boolean @default(true) // whether the published date shows on the blogs listing tile
  showAuthorOnCard Boolean @default(true) // whether the author name shows on the blogs listing tile
  excerpt        String?  @db.Text
  author         String   @default("NOBILITA Editorial Team")
  authorImage    String?
  heroImage      String?
  heroImageAlt   String?
  tag            String?
  tags           String[] @default([])
  content        Json     @default("[]")
  readTime       String?
  seoTitle       String?
  seoDescription String?
  order          Int      @default(0)
  status         Status   @default(DRAFT)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A newsletter edition — an admin-uploaded, fully self-contained HTML file
// (an email-campaign export, e.g. from Liana Mailer) served byte-for-byte at
// /newsletter/[slug] via a plain Route Handler (see
// app/newsletter/[slug]/route.ts) instead of a React page, so the file's own
// <html>/<head>/<body> and styling render exactly as uploaded — no site
// layout, Navbar, or Footer wrapped around it. No structured content
// fields; the uploaded file is the entire page.
model Newsletter {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  cardImage      String? // thumbnail on the /newsletter listing grid
  htmlFile       String? // path to the uploaded standalone HTML file
  seoTitle       String?
  seoDescription String?
  order          Int      @default(0)
  status         Status   @default(DRAFT)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Submission {
  id        String         @id @default(cuid())
  type      SubmissionType
  name      String
  email     String
  phone     String?
  message   String?        @db.Text
  product   String?
  language  String?
  source    String?
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([type])
}

model Media {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  alt       String?
  tags      String[] @default([])
  width     Int?
  height    Int?
  folder    String   @default("/")
  createdAt DateTime @default(now())
}

