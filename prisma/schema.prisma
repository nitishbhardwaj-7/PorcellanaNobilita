datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
}

enum Status {
  DRAFT
  PUBLISHED
}

enum SubmissionType {
  QUERY
  CATALOG
  NEWSLETTER
  DATASHEET
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  color            String   @default("White")
  finish           String?  // legacy single-value field, superseded by finishCategories below
  finishCategories String[] @default([]) // one or more of Polished/Matte/Honed/etc. — a product can be filtered under multiple finishes on the public site
  thicknessMm      String[]
  dimensions       String[]
  format           String?
  applications     String[]
  coverImage       String?
  gallery          String[] @default([])
  
  // Custom configuration for Exhibition/Featured product detail modal
  leftBg           String?
  faces            String[] @default([])
  finishes         String[] @default([])
  slides           Json     @default("[]")
  availableFaces   String[] @default([])
  bookmatchImg     String?
  isHorizontalFace Boolean  @default(false)
  isDark           Boolean  @default(false)

  order            Int      @default(0)
  status           Status   @default(DRAFT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Blog {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleColor     String   @default("black") // "black" | "teal" (#007190) — rendered color of the blog title
  titleFont      String   @default("ivymode") // "ivymode" | "michroma" — rendered font of the blog title
  titleFontSize  String   @default("standard") // "small" | "standard" | "large" | "xlarge" — rendered size of the blog title
  showDateOnCard   Boolean @default(true) // whether the published date shows on the blogs listing tile
  showAuthorOnCard Boolean @default(true) // whether the author name shows on the blogs listing tile
  excerpt        String?  @db.Text
  author         String   @default("NOBILITA Editorial Team")
  authorImage    String?
  heroImage      String?
  heroImageAlt   String?
  tag            String?
  tags           String[] @default([])
  content        Json     @default("[]")
  readTime       String?
  seoTitle       String?
  seoDescription String?
  order          Int      @default(0)
  status         Status   @default(DRAFT)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Submission {
  id        String         @id @default(cuid())
  type      SubmissionType
  name      String
  email     String
  phone     String?
  message   String?        @db.Text
  product   String?
  language  String?
  source    String?
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([type])
}

model Media {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  alt       String?
  tags      String[] @default([])
  width     Int?
  height    Int?
  folder    String   @default("/")
  createdAt DateTime @default(now())
}

model Settings {
  id             String   @id @default("global")
  siteName       String   @default("Porcellana Nobilita")
  logoLight      String?
  logoDark       String?
  contactEmail   String?
  contactPhone   String?
  footerText     String?
  socialLinks    Json     @default("{}")
  seoTitle       String?
  seoDescription String?

  // Downloadable PDFs — editable from the CMS. When null, the site falls back
  // to the bundled default file in /public/Pdfs/.
  catalogPdfUrl            String?
  catalogPdfName           String?
  datasheetPdfUrlEnglish   String?
  datasheetPdfNameEnglish  String?
  datasheetPdfUrlItalian   String?
  datasheetPdfNameItalian  String?

  // Homepage Hero section — editable from Admin > Homepage. The slideshow
  // images themselves live in the HeroSlide model below.
  heroTitle      String?
  heroSubtitle   String?  @db.Text
  heroButtonText String?
  heroButtonLink String?

  // Homepage Brand Intro section — editable from Admin > Homepage.
  brandTagImage   String? // top "Il Gres Imperiale d'Italia" tag graphic
  brandTagSubtext String? // small caption under the tag graphic
  brandImg        String? // middle NOBILITA logo image
  brandSubtitle   String? @db.Text // description paragraph
  brandBtn        String? // button text
  brandBtnLink    String? // button link

  // Homepage Craftsmanship section — editable from Admin > Homepage.
  craftHeading        String?
  craftParagraph      String? @db.Text
  craftBgImage        String? // desktop background
  craftBgImageMobile  String? // mobile background
  craftBadgeText      String?
  craftBadgeLink      String?
  craftCasaLabel      String? // small "CASA NOBILE" label, bottom corner

  // Homepage Legacy section (triptych) — editable from Admin > Homepage.
  legacyLeftImage    String? // left panel photo
  legacyLeftLabel    String? // left panel caption
  legacySketchImage  String? // center architectural sketch
  legacyLogoImage    String? // center NOBILITA logo
  legacyTaglineImage String? // center tagline graphic
  legacyRightImage   String? // right panel photo
  legacyRightLabel   String? // right panel caption

  // Homepage Applications section — editable from Admin > Homepage. The six
  // tiles themselves live in the ApplicationTile model below.
  applicationsHeading String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One slide in the homepage Hero's background slideshow. Editable order,
// image, label text, and label color from Admin > Homepage.
model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  label     String
  textColor String   @default("white") // "white" | "black" — label contrast against the image
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One tile in the homepage Applications grid. Always exactly six rows (two
// rows of three) — the admin can edit each tile's content but not add,
// remove, or move a tile between rows, keeping the fixed layout intact.
model ApplicationTile {
  id          String   @id @default(cuid())
  name        String // label shown on the tile, e.g. "INTERIOR WALLS"
  image       String
  productName String // which product opens when the tile is clicked
  row         Int // 1 or 2
  order       Int      @default(0) // position within its row
  darkLabel   Boolean  @default(false) // true = dark label text, false = white
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Master data — the set of Color/Finish options offered in the product form
// and the public explore-collection filters. Editable from the CMS instead
// of being a hardcoded list in the code.
model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Finish {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per static page — lets the CMS control each page's browser-tab
// title and SEO meta description independently. A page with no row (or
// blank fields) falls back to that page's hardcoded default.
model PageMeta {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  title       String?
  description String?
  updatedAt   DateTime @updatedAt
}
