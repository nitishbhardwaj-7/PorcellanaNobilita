datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
}

enum Status {
  DRAFT
  PUBLISHED
}

enum SubmissionType {
  QUERY
  CATALOG
  NEWSLETTER
  DATASHEET
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  color            String   @default("White")
  finish           String?  // legacy single-value field, superseded by finishCategories below
  finishCategories String[] @default([]) // one or more of Polished/Matte/Honed/etc. — a product can be filtered under multiple finishes on the public site
  thicknessMm      String[]
  dimensions       String[]
  format           String?
  applications     String[]
  coverImage       String?
  gallery          String[] @default([])
  
  // Custom configuration for Exhibition/Featured product detail modal
  leftBg           String?
  faces            String[] @default([])
  finishes         String[] @default([])
  slides           Json     @default("[]")
  availableFaces   String[] @default([])
  bookmatchImg     String?
  isHorizontalFace Boolean  @default(false)
  isDark           Boolean  @default(false)

  order            Int      @default(0)
  status           Status   @default(DRAFT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Blog {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleColor     String   @default("black") // "black" | "teal" (#007190) — rendered color of the blog title
  titleFont      String   @default("ivymode") // "ivymode" | "michroma" — rendered font of the blog title
  titleFontSize  String   @default("standard") // "small" | "standard" | "large" | "xlarge" — rendered size of the blog title
  showDateOnCard   Boolean @default(true) // whether the published date shows on the blogs listing tile
  showAuthorOnCard Boolean @default(true) // whether the author name shows on the blogs listing tile
  excerpt        String?  @db.Text
  author         String   @default("NOBILITA Editorial Team")
  authorImage    String?
  heroImage      String?
  heroImageAlt   String?
  tag            String?
  tags           String[] @default([])
  content        Json     @default("[]")
  readTime       String?
  seoTitle       String?
  seoDescription String?
  order          Int      @default(0)
  status         Status   @default(DRAFT)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Submission {
  id        String         @id @default(cuid())
  type      SubmissionType
  name      String
  email     String
  phone     String?
  message   String?        @db.Text
  product   String?
  language  String?
  source    String?
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([type])
}

model Media {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  alt       String?
  tags      String[] @default([])
  width     Int?
  height    Int?
  folder    String   @default("/")
  createdAt DateTime @default(now())
}

model Settings {
  id             String   @id @default("global")
  siteName       String   @default("Porcellana Nobilita")
  logoLight      String?
  logoDark       String?
  contactEmail   String?
  contactPhone   String?
  footerText     String?
  socialLinks    Json     @default("{}")
  seoTitle       String?
  seoDescription String?

  // Downloadable PDFs — editable from the CMS. When null, the site falls back
  // to the bundled default file in /public/Pdfs/.
  catalogPdfUrl            String?
  catalogPdfName           String?
  datasheetPdfUrlEnglish   String?
  datasheetPdfNameEnglish  String?
  datasheetPdfUrlItalian   String?
  datasheetPdfNameItalian  String?

  // Homepage Hero section — editable from Admin > Homepage. The slideshow
  // images themselves live in the HeroSlide model below.
  heroTitle      String?
  heroTitleColor String? // "default" | "black" | "teal" | "grey" | "white"
  heroTitleFont  String? // "default" | "ivymode" | "michroma"
  heroTitleSize  String? // "default" or a px value, e.g. "40"
  heroSubtitle   String?  @db.Text
  heroSubtitleColor String?
  heroSubtitleFont  String?
  heroSubtitleSize  String?
  heroButtonText String?
  heroButtonLink String?

  // Homepage Brand Intro section — editable from Admin > Homepage.
  brandTagImage   String? // top "Il Gres Imperiale d'Italia" tag graphic
  brandTagSubtext String? // small caption under the tag graphic
  brandImg        String? // middle NOBILITA logo image
  brandSubtitle   String? @db.Text // description paragraph
  brandSubtitleColor String?
  brandSubtitleFont  String?
  brandSubtitleSize  String?
  brandBtn        String? // button text
  brandBtnLink    String? // button link

  // Homepage Craftsmanship section — editable from Admin > Homepage.
  craftHeading        String?
  craftHeadingColor   String?
  craftHeadingFont    String?
  craftHeadingSize    String?
  craftParagraph      String? @db.Text
  craftParagraphColor String?
  craftParagraphFont  String?
  craftParagraphSize  String?
  craftBgImage        String? // desktop background
  craftBgImageMobile  String? // mobile background
  craftBadgeText      String?
  craftBadgeLink      String?
  craftCasaLabel      String? // small "CASA NOBILE" label, bottom corner

  // Homepage Legacy section (triptych) — editable from Admin > Homepage.
  legacyLeftImage    String? // left panel photo
  legacyLeftLabel    String? // left panel caption
  legacySketchImage  String? // center architectural sketch
  legacyLogoImage    String? // center NOBILITA logo
  legacyTaglineImage String? // center tagline graphic
  legacyRightImage   String? // right panel photo
  legacyRightLabel   String? // right panel caption

  // Homepage Applications section — editable from Admin > Homepage. The six
  // tiles themselves live in the ApplicationTile model below.
  applicationsHeading String?
  applicationsHeadingColor String?
  applicationsHeadingFont  String?
  applicationsHeadingSize  String?

  // Homepage Dimensions section — editable from Admin > Homepage. Fixed
  // 3-column x 2-item spec grid (Thickness / Dimensions / Format).
  dimHeading   String?
  dimHeadingColor String?
  dimHeadingFont  String?
  dimHeadingSize  String?
  dimCol1Header String? // THICKNESS
  dimCol1Item1  String?
  dimCol1Item2  String?
  dimCol2Header String? // DIMENSIONS
  dimCol2Item1  String?
  dimCol2Item2  String?
  dimCol3Header String? // FORMAT
  dimCol3Item1  String?
  dimCol3Item2  String?
  dimImage      String?
  dimBtnText    String?
  dimBtnLink    String?

  // Homepage Finishes section — editable from Admin > Homepage. Fixed set of
  // five finish tiles (Polished / Matte / Honed / Structured Matte / 3D-5D
  // Matte); each tile's filter-routing identity stays fixed in code, only
  // its label, image, and description text are editable here.
  finishesHeading String?
  finishesHeadingColor String?
  finishesHeadingFont  String?
  finishesHeadingSize  String?
  finish1Name  String?
  finish1Image String?
  finish1Desc  String? @db.Text
  finish1DescColor String?
  finish1DescFont  String?
  finish1DescSize  String?
  finish2Name  String?
  finish2Image String?
  finish2Desc  String? @db.Text
  finish2DescColor String?
  finish2DescFont  String?
  finish2DescSize  String?
  finish3Name  String?
  finish3Image String?
  finish3Desc  String? @db.Text
  finish3DescColor String?
  finish3DescFont  String?
  finish3DescSize  String?
  finish4Name  String?
  finish4Image String?
  finish4Desc  String? @db.Text
  finish4DescColor String?
  finish4DescFont  String?
  finish4DescSize  String?
  finish5Name  String?
  finish5Image String?
  finish5Desc  String? @db.Text
  finish5DescColor String?
  finish5DescFont  String?
  finish5DescSize  String?

  // Our Story page — editable from Admin > Our Story. Layout, GSAP/Framer
  // animations, and section order stay fixed; only text, images, and each
  // "view product" button's label + target product are editable. A few
  // paragraphs that carry an inline colored highlight phrase stay hardcoded
  // (out of plain-text scope) — noted per field below.
  storyHeroTitle String? // default "OUR STORY"
  storyHeroPara1 String? @db.Text
  storyHeroPara2 String? @db.Text
  // (hero paragraph 3 has an inline highlighted phrase — stays hardcoded)
  storySec2Heading String? // default "PIANO NOBILE, REIMAGINED"
  storySec2Line1   String? @db.Text
  // (sec2 line 2 has an inline highlighted word "extraordinary" — stays hardcoded)
  storySec2Line3      String? @db.Text
  storySec2BgImage    String? // Arabescato Fjord background
  storySec2Image      String? // Verde Profondo application photo
  storySec2BtnText    String? // default "VERDE PROFONDO"
  storySec2ProductName String? // which product the button opens
  storySec3Para        String? @db.Text
  storySec3BtnText     String? // default "BASALTINA"
  storySec3ProductName String? // which product the button opens
  storySec4Heading String? // default "NEXT GENERATION PORCELAIN"
  storySec4Line1   String? @db.Text
  storySec4Line2   String? @db.Text
  // (sec4 line 3 has an inline highlighted phrase "beauty that endures." — stays hardcoded)
  storySec4BgImage     String? // Fior Di Melo background
  storySec4Image       String? // Ferro Industriale application photo
  storySec4BtnText     String? // default "FERRO INDUSTRIALE"
  storySec4ProductName String? // which product the button opens

  // Made in Italy page — editable from Admin > Made in Italy. Layout,
  // GSAP/Framer animations, and section order stay fixed; only text and
  // images are editable. The Duomo video, the Colosseum tag graphic, and a
  // paragraph carrying an inline colored highlight phrase stay hardcoded.
  miHeading             String? // default "MADE IN ITALY"
  miSec1Label           String? // default "DUOMO DI MILANO"
  miSec2Para1           String? @db.Text
  // (sec2 paragraph 2 has an inline highlighted phrase — stays hardcoded)
  miSec2Image           String? // Palazzo della Civiltà Italiana photo
  miSec2ImageLabel      String? // default "PALAZZO DELLA CIVILTÀ ITALIANA"
  miSec3Line1           String? @db.Text
  // (sec3 line 2 has an inline highlighted phrase — stays hardcoded)
  miSec3LeftImage       String? // factory photo
  miSec3RightImage      String? // large-format slab processing unit photo
  miSec3RightImageLabel String? // default "LARGE FORMAT SLABS PROCESSING UNIT"
  miSec3BottomPara      String? @db.Text
  miSec4BgImage         String? // Colosseum photo (desktop)
  miSec4BgImageMobile   String? // Colosseum photo (mobile)
  miSec4Label           String? // default "COLOSSEUM"

  // Technical Data page (/technical-data) — editable from Admin > Technical
  // Data. Layout, GSAP animations, and section order stay fixed. The Duomo
  // video-style hero background, the spill-care how-to subsections (Oil /
  // Coffee / Wine), the inlined format & dimensions SVG diagram, and the
  // labeled thickness diagram image stay hardcoded — out of plain-text/safe
  // -image scope (the thickness image has percentage-positioned text
  // overlays tied to its exact geometry, and the dimensions SVG is inlined
  // via dangerouslySetInnerHTML so isn't safe to point at arbitrary input).
  tdHeading    String? // default "ENGINEERED FOR PERFORMANCE"
  tdHeroDesc   String? @db.Text

  tdCharHeading String? // default "CHARACTERISTICS" — fixed set of 9 items
  tdChar1Title String?
  tdChar1Desc  String? @db.Text
  tdChar1Icon  String?
  tdChar2Title String?
  tdChar2Desc  String? @db.Text
  tdChar2Icon  String?
  tdChar3Title String?
  tdChar3Desc  String? @db.Text
  tdChar3Icon  String?
  tdChar4Title String?
  tdChar4Desc  String? @db.Text
  tdChar4Icon  String?
  tdChar5Title String?
  tdChar5Desc  String? @db.Text
  tdChar5Icon  String?
  tdChar6Title String?
  tdChar6Desc  String? @db.Text
  tdChar6Icon  String?
  tdChar7Title String?
  tdChar7Desc  String? @db.Text
  tdChar7Icon  String?
  tdChar8Title String?
  tdChar8Desc  String? @db.Text
  tdChar8Icon  String?
  tdChar9Title String?
  tdChar9Desc  String? @db.Text
  tdChar9Icon  String?

  tdUgHeading String? // default "USER GUIDE"
  tdUgDesc1   String? @db.Text
  tdUgDesc2   String? @db.Text

  tdDimHeading String? // default "FORMAT & DIMENSIONS"
  tdDimDesc1   String? @db.Text
  tdDimDesc2   String? @db.Text
  tdDimDesc3   String? @db.Text

  tdThickHeading String? // default "THICKNESSES"
  tdThickDesc1   String? @db.Text
  tdThickDesc2   String? @db.Text

  tdSpecsHeading String? // default "TECHNICAL SPECIFICATIONS FOR PROFESSIONALS"

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One slide in the homepage Hero's background slideshow. Editable order,
// image, label text, and label color from Admin > Homepage.
model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  label     String
  textColor String   @default("white") // "white" | "black" — label contrast against the image
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One slide in the homepage Technical Data section's background slideshow.
// Editable order, image, label text, and label color from Admin > Homepage —
// same shape and admin UI pattern as HeroSlide above.
model TechDataSlide {
  id        String   @id @default(cuid())
  image     String
  label     String
  textColor String   @default("black") // "white" | "black" — label contrast against the image
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One tile in the homepage Applications grid. Always exactly six rows (two
// rows of three) — the admin can edit each tile's content but not add,
// remove, or move a tile between rows, keeping the fixed layout intact.
model ApplicationTile {
  id          String   @id @default(cuid())
  name        String // label shown on the tile, e.g. "INTERIOR WALLS"
  image       String
  productName String // which product opens when the tile is clicked
  row         Int // 1 or 2
  order       Int      @default(0) // position within its row
  darkLabel   Boolean  @default(false) // true = dark label text, false = white
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Master data — the set of Color/Finish options offered in the product form
// and the public explore-collection filters. Editable from the CMS instead
// of being a hardcoded list in the code.
model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Finish {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per static page — lets the CMS control each page's browser-tab
// title and SEO meta description independently. A page with no row (or
// blank fields) falls back to that page's hardcoded default.
model PageMeta {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  title       String?
  description String?
  updatedAt   DateTime @updatedAt
}
