// One slide in the homepage Hero's background slideshow. Editable order,
// image, label text, and label color from Admin > Homepage.
model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  label     String
  textColor String   @default("white") // "white" | "black" — label contrast against the image
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One slide in the homepage Technical Data section's background slideshow.
// Editable order, image, label text, and label color from Admin > Homepage —
// same shape and admin UI pattern as HeroSlide above.
model TechDataSlide {
  id        String   @id @default(cuid())
  image     String
  label     String
  textColor String   @default("black") // "white" | "black" — label contrast against the image
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One tile in the homepage Applications grid. Always exactly six rows (two
// rows of three) — the admin can edit each tile's content but not add,
// remove, or move a tile between rows, keeping the fixed layout intact.
model ApplicationTile {
  id          String   @id @default(cuid())
  name        String // label shown on the tile, e.g. "INTERIOR WALLS"
  image       String
  productName String // which product opens when the tile is clicked
  row         Int // 1 or 2
  order       Int      @default(0) // position within its row
  darkLabel   Boolean  @default(false) // true = dark label text, false = white
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One tile in the homepage Finishes accordion (Admin > Homepage > Finishes).
// Add/remove/reorder freely — unlike ApplicationTile above, this section has
// no fixed count. `filterName` is the value matched against the Explore
// Collection page's Finish filter (and each product's finishCategories) when
// a visitor clicks the tile; it can differ from the display `name` (e.g.
// name "3D / 5D MATTE" vs filterName "3D-5D Matte") for legacy tiles carried
// over from the original fixed five. `textStyle` picks the tile's idle text
// color and overlay tone ("dark" = dark text, near-transparent overlay that
// only tints slightly on hover; "light" = white text, dimmed overlay so it
// stays readable over a bright image). `lightWash` adds an extra soft white
// overlay on top of a "dark" tile — only meaningful when textStyle is
// "dark" — for a busy/light image that needs a touch more contrast wash
// (mirrors the original "Structured Matte" tile's treatment).
model HomeFinishTile {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  name        String
  filterName  String
  image       String?
  desc        String?  @db.Text
  descColor   String?
  descFont    String?
  descSize    String?
  textStyle   String   @default("dark")
  lightWash   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Master data — the set of Color/Finish options offered in the product form
// and the public explore-collection filters. Editable from the CMS instead
// of being a hardcoded list in the code.
model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Finish {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per static page — lets the CMS control each page's browser-tab
// title and SEO meta description independently. A page with no row (or
// blank fields) falls back to that page's hardcoded default.
model PageMeta {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  title       String?
  description String?
  updatedAt   DateTime @updatedAt
}
